# Copie para .env no servidor (cp .env.example .env) e troque todos os valores.
# O arquivo .env real nunca é versionado.

# Domínio com registro DNS tipo A apontando para o IP do VPS
DOMINIO=app.exemplo.com.br

POSTGRES_USER=alimentams
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
POSTGRES_DB=alimentams

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-48-caracteres
